# ============================================================
# 🖋️ Inkflow Editor - Git Ignore Configuration
# ============================================================

# 1. 依赖目录 (Dependencies)
node_modules/
/jspm_packages/
/web_modules/

# 2. 编译产物 (Build output)
dist/
dist-ssr/
*.local

# 3. 日志文件与缓存 (Logs and caches)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
.vite

# 4. 操作系统临时文件 (OS generated files)
.DS_Store
Thumbs.db
Desktop.ini

# 5. IDE / 编辑器专属配置文件 (Editor directories and files)
.vscode/*
!.vscode/extensions.json  # 核心保留：共享推荐插件配置给其他贡献者
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?                     # 覆盖了 .swp, .swo 等各种 Vim 临时文件

# 6. 本地环境变量配置文件 (Environment variables - 绝对安全防线)
.env
.env.local
.env.*.local

# 7. 测试覆盖率报告 (Testing)
coverage/
releases/
*.zip